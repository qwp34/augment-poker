# .env.example — 개발 시 .env로 복사해 사용
# localhost로 고정하면 다른 기기(LAN IP)에서 접속할 때 ERR_CONNECTION_REFUSED가 난다 —
# 비워두면(주석 유지) colyseusClient.ts가 접속한 호스트명을 따라가는 동적 기본값을 쓴다.
# 배포된 서버 등 정말 고정 주소가 필요할 때만 주석을 풀고 값을 채운다.
# VITE_SERVER_URL=ws://localhost:2567

# Supabase (로그인/칩 영속성) — 프로젝트 설정 > API 에서 확인
# anon key는 공개되어도 되는 키(RLS로 보호됨)지만, service role 키는 여기 넣지 말 것 (server/.env.example 참고)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
